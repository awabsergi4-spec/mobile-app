<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: Android blocks cleartext (HTTP) traffic by default for
  apps targeting API 28+. The dev/staging backend runs over plain HTTP on
  the Android Emulator's host-loopback alias (10.0.2.2, see
  core/config/app_config.dart) and localhost — this allowlist scopes
  cleartext to exactly those dev hosts. It has no effect on release builds,
  which use a separate manifest with no networkSecurityConfig override, so
  they fall back to the platform default (HTTPS-only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
