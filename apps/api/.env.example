# Copy to .env. Same PostgreSQL database and SAME RS256 keypair as apps/backend
# (the Admin Platform verifies access tokens issued by this API).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sahl?schema=public"
# Single line each, double-quoted, newlines written as \n.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
# Browser origins allowed by CORS (Flutter web, admin). Native apps don't need this.
ALLOWED_ORIGINS="http://localhost:5757,http://localhost:3000"
DEFAULT_REGION_CODE="SD"
