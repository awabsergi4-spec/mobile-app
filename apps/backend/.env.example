# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sahl?schema=public"

# Redis (BullMQ background jobs + realtime Socket.IO adapter)
REDIS_URL="redis://localhost:6379"

# Realtime server (src/realtime/server.ts) — separate process from the
# Next.js app. ALLOWED_ORIGINS defaults to an empty list (no CORS origins
# allowed) if unset, so this MUST be set in production or the realtime
# server will reject every browser/app connection.
REALTIME_PORT="4001"
ALLOWED_ORIGINS="http://localhost:3000"

# Auth — RS256 keypair (docs/05-security.md §1). Generate a dev keypair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# then paste each PEM's contents here with \n for newlines (or read from a
# file path in a real deployment instead of inlining the key material).
# infrastructure/identity/auth-services.ts throws at startup if these are
# unset, rather than silently issuing tokens with an empty signing key.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase Cloud Messaging
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Default region seed (see prisma/seed.ts)
DEFAULT_REGION_CODE="SD"
DEFAULT_REGION_CURRENCY="SDG"
DEFAULT_REGION_LANGUAGE="ar"

# Bootstrap SUPER_ADMIN operator — seeded directly (ACTIVE, not via OTP)
# since there's no self-service way to become staff. Change these before
# running the seed against any shared/production database; the fallback
# values in prisma/seed.ts are dev-only.
SEED_ADMIN_PHONE="+249900000000"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# SAHL API (apps/api, FastAPI). The Admin Platform calls it for auth and Users.
SAHL_API_URL="http://localhost:8000"
